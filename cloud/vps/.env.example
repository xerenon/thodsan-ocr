# Copy to .env and fill in. Do NOT commit the real .env.
RUNPOD_ENDPOINT_ID=wtoixvuklw37td
RUNPOD_API_KEY=rpa_xxx_your_runpod_api_key

# Optional: if set, clients MUST send this value as the  X-API-Key  header.
# Leave empty to make the API open (not recommended on a public VPS).
API_KEY=change-me-to-a-long-random-string

# Default output cap. 4096 comfortably covers a full A4 page of Thai text.
OCR_MAX_TOKENS=4096
# Max seconds to wait for a job (covers worker cold start + long pages).
OCR_TIMEOUT=300
# Comma-separated CORS origins, or * for any.
CORS_ORIGINS=*
